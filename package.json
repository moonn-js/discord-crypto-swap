{
  "name": "discord-swap-single-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A private ticket-based Discord bot for non-custodial NEAR Intents 1Click swaps.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "rates:changenow": "node scripts/changenow-rates.js",
    "rates:changelly": "node scripts/changelly-rates.js",
    "setup:changelly": "node scripts/changelly-setup.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.25",
    "@solana/addresses": "7.0.0",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "vitest": "4.1.10"
  }
}
