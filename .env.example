# Discord application credentials and pre-created guild locations.
# Legacy single-guild variables remain supported. For multiple guilds, leave the
# five location variables blank and set DISCORD_GUILDS_JSON to a JSON array using
# the shape documented in README.md.
DISCORD_TOKEN=
DISCORD_GUILDS_JSON=
DISCORD_GUILD_ID=
PANEL_CHANNEL_ID=
TICKET_CATEGORY_ID=
COMPLETED_DEALS_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=
# Optional. When set, successful swap owners receive a DM linking to this channel.
VOUCH_CHANNEL_ID=
# Enable the administrator-only guided /setup command for this bot identity.
SELF_SERVICE_SETUP_ENABLED=false
CHANGENOW_API_KEY=
# Optional. Competes with NEAR Intents for the highest net output using deposit addresses.
RELAY_API_KEY=
CHANGELLY_PRIVATE_KEY_HEX=
CHANGELLY_ENABLED=false
FIXEDFLOAT_API_KEY=
FIXEDFLOAT_API_SECRET=
CHANGELLY_ZERO_COMMISSION_CONFIRMED=false
# Rates work with false. Set true only after ChangeNOW confirms 0% partner commission.
CHANGENOW_ZERO_COMMISSION_CONFIRMED=false
# Optional private archive destination that receives a copy of every final transcript.
# Configure both values together. This destination is not shown in the /setup wizard.
CENTRAL_TRANSCRIPT_GUILD_ID=
CENTRAL_TRANSCRIPT_CHANNEL_ID=

# NEAR Intents 1Click partner JWT. Never commit this value.
ONECLICK_JWT=

# PostgreSQL
DATABASE_URL=postgresql://swapbot:swapbot@localhost:5432/swapbot
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Swap policy
SLIPPAGE_BPS=50
# Optional quote-time target for network + spread + application fee. 30 = 0.30%.
# Leave at 0 to disable application fees. A recipient is required when enabled.
TARGET_TOTAL_COST_BPS=0
BOT_FEE_RECIPIENT=
QUOTE_WAIT_MS=3000
PREVIEW_TTL_MINUTES=5
FUNDING_DEADLINE_MINUTES=60
STALE_TRACKING_HOURS=24

# Ticket and retention policy
TICKET_INACTIVITY_MINUTES=30
TICKET_INACTIVITY_REMINDER_MINUTES=5
CHANNEL_DELETE_DELAY_MINUTES=5
TERMINAL_RETENTION_DAYS=30
ABANDONED_RETENTION_HOURS=24
# Runtime
ASSET_REFRESH_MINUTES=10
STATUS_WORKER_INTERVAL_SECONDS=5
STATUS_CONCURRENCY=2

# Optional early destination-payout detection. 1Click SUCCESS remains authoritative.
PAYOUT_MONITOR_INTERVAL_SECONDS=2
# Configure all three values together for unconfirmed BTC/LTC/DOGE webhooks.
BLOCKCYPHER_API_TOKEN=
PAYOUT_WEBHOOK_BASE_URL=
PAYOUT_WEBHOOK_SECRET=
# Optional Helius override for Solana. If unset, the free PublicNode endpoints below are used.
HELIUS_API_KEY=
# SOL, SPL USDT, and SPL USDC processed-commitment monitoring.
# These default to PublicNode when blank; set both only to override that provider.
PAYOUT_SOL_RPC_URL=
PAYOUT_SOL_WS_URL=
# Native/ERC-20 pending-state monitoring. ETH and BNB Chain default to PublicNode.
PAYOUT_ETH_RPC_URL=
PAYOUT_ARBITRUM_RPC_URL=
PAYOUT_BASE_RPC_URL=
PAYOUT_OPTIMISM_RPC_URL=
PAYOUT_BSC_RPC_URL=
PAYOUT_POLYGON_RPC_URL=
PAYOUT_AVALANCHE_RPC_URL=

PORT=3000
LOG_LEVEL=info
